+#define KITTY_KEY_RIGHT_HYPER  57451
+#define KITTY_KEY_RIGHT_META   57452
+#define KITTY_KEY_ISO_LEVEL3_SHIFT 57453
+#define KITTY_KEY_ISO_LEVEL5_SHIFT 57454
