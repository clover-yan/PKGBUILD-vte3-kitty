@@ -5280,7 +5325,342 @@ bool
 Terminal::widget_key_press(vte::platform::KeyEvent const& event)
 {
         auto handled = false;
-	char *normal = NULL;
+        char *normal = NULL;
+
+        /*
+         * kitty keyboard protocol implementation.
+         *
+         */
+        if (m_kitty_keyboard_flags > 0 &&
+            m_kitty_keyboard_mode_is_available &&
+            event.keycode()) {
+
+                unsigned int kitty_key = 0;
+                unsigned int shifted_key = 0;
+                unsigned int base_key = 0;
+                unsigned int modifiers = 0;
+                bool is_keypad_key = false;
+                unsigned int key_mod_mask = 0;
+
+                xkb_keysym_t base_sym = xkb_state_key_get_one_sym(m_xkb_data.state_us, event.keycode());
+                if (base_sym >= 0x20 && base_sym < 0x7f) {
+                    base_key = base_sym;
+                }
+
+                if (event.modifiers() & GDK_SHIFT_MASK)   modifiers |= 1;
+                if (event.modifiers() & VTE_ALT_MASK)     modifiers |= 2;
+                if (event.modifiers() & GDK_CONTROL_MASK) modifiers |= 4;
+                if (event.modifiers() & GDK_SUPER_MASK)   modifiers |= 8;
+                if (event.modifiers() & GDK_HYPER_MASK)   modifiers |= 16;
+                if (event.modifiers() & GDK_META_MASK)    modifiers |= 32;
+                if (event.modifiers() & GDK_LOCK_MASK)    modifiers |= 64;
+
+                guint numlock_mask = VTE_NUMLOCK_MASK;
+                if (numlock_mask == 0)
+                        numlock_mask = (1 << 4);
+                if (event.modifiers() & numlock_mask)
+                        modifiers |= 128;
+
+                bool report_all = (m_kitty_keyboard_flags & 8) != 0;
+                bool disambiguate = (m_kitty_keyboard_flags & 1) != 0;
+                bool report_event_types = (m_kitty_keyboard_flags & 2) != 0;
+
+                if (!report_all && !disambiguate && !report_event_types) {
+                        if (modifiers == 0) {
+                                switch (event.keyval()) {
+                                case GDK_KEY_F1:
+                                case GDK_KEY_F2:
+                                case GDK_KEY_F3:
+                                case GDK_KEY_F4:
+                                case GDK_KEY_Escape:
+                                        goto legacy_fallback;
+                                }
+                        }
+                        if (event.keyval() == GDK_KEY_Escape) {
+                                send_child((modifiers & 2) ?
+                                           "\x1b\x1b" : "\x1b");
+                                return true;
+                        }
+                }
+
+                switch (event.keyval()) {
+                case GDK_KEY_Escape:    kitty_key = KITTY_KEY_ESCAPE;    break;
+                case GDK_KEY_Return:    kitty_key = KITTY_KEY_ENTER;     break;
+                case GDK_KEY_Tab:       kitty_key = KITTY_KEY_TAB;       break;
+                case GDK_KEY_BackSpace: kitty_key = KITTY_KEY_BACKSPACE; break;
+                case GDK_KEY_Insert:    kitty_key = KITTY_KEY_INSERT;    break;
+                case GDK_KEY_Delete:    kitty_key = KITTY_KEY_DELETE;    break;
+                case GDK_KEY_Left:      kitty_key = KITTY_KEY_LEFT;      break;
+                case GDK_KEY_Right:     kitty_key = KITTY_KEY_RIGHT;     break;
+                case GDK_KEY_Up:        kitty_key = KITTY_KEY_UP;        break;
+                case GDK_KEY_Down:      kitty_key = KITTY_KEY_DOWN;      break;
+                case GDK_KEY_Page_Up:   kitty_key = KITTY_KEY_PAGE_UP;   break;
+                case GDK_KEY_Page_Down: kitty_key = KITTY_KEY_PAGE_DOWN; break;
+                case GDK_KEY_Home:      kitty_key = KITTY_KEY_HOME;      break;
+                case GDK_KEY_End:       kitty_key = KITTY_KEY_END;       break;
+                case GDK_KEY_F1:        kitty_key = KITTY_KEY_F1;        break;
+                case GDK_KEY_F2:        kitty_key = KITTY_KEY_F2;        break;
+                case GDK_KEY_F3:        kitty_key = KITTY_KEY_F3;        break;
+                case GDK_KEY_F4:        kitty_key = KITTY_KEY_F4;        break;
+                case GDK_KEY_F5:        kitty_key = KITTY_KEY_F5;        break;
+                case GDK_KEY_F6:        kitty_key = KITTY_KEY_F6;        break;
+                case GDK_KEY_F7:        kitty_key = KITTY_KEY_F7;        break;
+                case GDK_KEY_F8:        kitty_key = KITTY_KEY_F8;        break;
+                case GDK_KEY_F9:        kitty_key = KITTY_KEY_F9;        break;
+                case GDK_KEY_F10:       kitty_key = KITTY_KEY_F10;       break;
+                case GDK_KEY_F11:       kitty_key = KITTY_KEY_F11;       break;
+                case GDK_KEY_F12:       kitty_key = KITTY_KEY_F12;       break;
+
+                case GDK_KEY_KP_0:      kitty_key = KITTY_KEY_KP_0; is_keypad_key = true; break;
+                case GDK_KEY_KP_1:      kitty_key = KITTY_KEY_KP_1; is_keypad_key = true; break;
+                case GDK_KEY_KP_2:      kitty_key = KITTY_KEY_KP_2; is_keypad_key = true; break;
+                case GDK_KEY_KP_3:      kitty_key = KITTY_KEY_KP_3; is_keypad_key = true; break;
+                case GDK_KEY_KP_4:      kitty_key = KITTY_KEY_KP_4; is_keypad_key = true; break;
+                case GDK_KEY_KP_5:      kitty_key = KITTY_KEY_KP_5; is_keypad_key = true; break;
+                case GDK_KEY_KP_6:      kitty_key = KITTY_KEY_KP_6; is_keypad_key = true; break;
+                case GDK_KEY_KP_7:      kitty_key = KITTY_KEY_KP_7; is_keypad_key = true; break;
+                case GDK_KEY_KP_8:      kitty_key = KITTY_KEY_KP_8; is_keypad_key = true; break;
+                case GDK_KEY_KP_9:      kitty_key = KITTY_KEY_KP_9; is_keypad_key = true; break;
+                case GDK_KEY_KP_Decimal:   kitty_key = KITTY_KEY_KP_DECIMAL;   is_keypad_key = true; break;
+                case GDK_KEY_KP_Divide:    kitty_key = KITTY_KEY_KP_DIVIDE;    is_keypad_key = true; break;
+                case GDK_KEY_KP_Multiply:  kitty_key = KITTY_KEY_KP_MULTIPLY;  is_keypad_key = true; break;
+                case GDK_KEY_KP_Subtract:  kitty_key = KITTY_KEY_KP_SUBTRACT;  is_keypad_key = true; break;
+                case GDK_KEY_KP_Add:       kitty_key = KITTY_KEY_KP_ADD;       is_keypad_key = true; break;
+                case GDK_KEY_KP_Enter:     kitty_key = KITTY_KEY_KP_ENTER;     is_keypad_key = true; break;
+                case GDK_KEY_KP_Equal:     kitty_key = KITTY_KEY_KP_EQUAL;     is_keypad_key = true; break;
+                case GDK_KEY_KP_Separator: kitty_key = KITTY_KEY_KP_SEPARATOR; is_keypad_key = true; break;
+
+                case GDK_KEY_KP_Home:      kitty_key = 57423; is_keypad_key = true; break;
+                case GDK_KEY_KP_End:       kitty_key = 57424; is_keypad_key = true; break;
+                case GDK_KEY_KP_Insert:    kitty_key = 57425; is_keypad_key = true; break;
+                case GDK_KEY_KP_Delete:    kitty_key = 57426; is_keypad_key = true; break;
+                case GDK_KEY_KP_Page_Up:   kitty_key = 57421; is_keypad_key = true; break;
+                case GDK_KEY_KP_Page_Down: kitty_key = 57422; is_keypad_key = true; break;
+                case GDK_KEY_KP_Up:        kitty_key = 57419; is_keypad_key = true; break;
+                case GDK_KEY_KP_Down:      kitty_key = 57420; is_keypad_key = true; break;
+                case GDK_KEY_KP_Left:      kitty_key = 57417; is_keypad_key = true; break;
+                case GDK_KEY_KP_Right:     kitty_key = 57418; is_keypad_key = true; break;
+                case GDK_KEY_KP_Begin:     kitty_key = 57427; is_keypad_key = true; break;
+
+                default:
+                        kitty_key = gdk_keyval_to_unicode(event.keyval());
+                        break;
+                }
+
+                if (kitty_key > 0) {
+                        unsigned int unshifted_key;
+                        unsigned int text_codepoint = 0;
+                        bool is_modifier_key = (key_mod_mask != 0);
+                        bool is_plain_special = (kitty_key == KITTY_KEY_TAB ||
+                                                 kitty_key == KITTY_KEY_ENTER ||
+                                                 kitty_key == KITTY_KEY_BACKSPACE);
+                        bool is_regular_text_key = !is_modifier_key &&
+                                                   !is_keypad_key &&
+                                                   !is_plain_special &&
+                                                   (kitty_key >= 32 &&
+                                                    kitty_key < 57344 &&
+                                                    kitty_key != 127);
+
+                        unsigned int gdk_unicode = gdk_keyval_to_unicode(event.keyval());
+                        bool produces_text = (gdk_unicode >= 32 &&
+                                              gdk_unicode < 0xD800 &&
+                                              gdk_unicode != 127);
+
+                        // Fallback for keypad digits (NumLock handling)
+                        if (!produces_text && is_keypad_key && (modifiers & 128)) {
+                                if (event.keyval() >= GDK_KEY_KP_0 &&
+                                    event.keyval() <= GDK_KEY_KP_9) {
+                                        gdk_unicode = '0' + (event.keyval() - GDK_KEY_KP_0);
+                                        produces_text = true;
+                                } else {
+                                        switch (event.keyval()) {
+                                        case GDK_KEY_KP_Decimal:  gdk_unicode = '.'; produces_text = true; break;
+                                        case GDK_KEY_KP_Divide:   gdk_unicode = '/'; produces_text = true; break;
+                                        case GDK_KEY_KP_Multiply: gdk_unicode = '*'; produces_text = true; break;
+                                        case GDK_KEY_KP_Subtract: gdk_unicode = '-'; produces_text = true; break;
+                                        case GDK_KEY_KP_Add:      gdk_unicode = '+'; produces_text = true; break;
+                                        case GDK_KEY_KP_Enter:    gdk_unicode = '\r'; produces_text = true; break;
+                                        case GDK_KEY_KP_Equal:    gdk_unicode = '='; produces_text = true; break;
+                                        case GDK_KEY_KP_Separator:gdk_unicode = ','; produces_text = true; break;
+                                        }
+                                }
+                        }
+
+                        if (is_plain_special) {
+                                unshifted_key = kitty_key;
+                                shifted_key = 0;
+                                text_codepoint = kitty_key;
+                        } else if (is_regular_text_key) {
+                                unshifted_key = gdk_keyval_to_unicode(
+                                                    gdk_keyval_to_lower(event.keyval()));
+                                
+                                if (unshifted_key == 0) unshifted_key = kitty_key;
+
+                                switch (unshifted_key) {
+                                case '`': shifted_key = '~'; break; case '1': shifted_key = '!'; break;
+                                case '2': shifted_key = '@'; break; case '3': shifted_key = '#'; break;
+                                case '4': shifted_key = '$'; break; case '5': shifted_key = '%'; break;
+                                case '6': shifted_key = '^'; break; case '7': shifted_key = '&'; break;
+                                case '8': shifted_key = '*'; break; case '9': shifted_key = '('; break;
+                                case '0': shifted_key = ')'; break; case '-': shifted_key = '_'; break;
+                                case '=': shifted_key = '+'; break; case '[': shifted_key = '{'; break;
+                                case ']': shifted_key = '}'; break; case '\\': shifted_key = '|'; break;
+                                case ';': shifted_key = ':'; break; case '\'': shifted_key = '"'; break;
+                                case ',': shifted_key = '<'; break; case '.': shifted_key = '>'; break;
+                                case '/': shifted_key = '?'; break;
+                                default: shifted_key = gdk_keyval_to_unicode(
+                                                           gdk_keyval_to_upper(event.keyval())); break;
+                                }
+                                
+                                switch(unshifted_key) {
+                                    case '~': unshifted_key = '`'; break; case '!': unshifted_key = '1'; break;
+                                    case '@': unshifted_key = '2'; break; case '#': unshifted_key = '3'; break;
+                                    case '$': unshifted_key = '4'; break; case '%': unshifted_key = '5'; break;
+                                    case '^': unshifted_key = '6'; break; case '&': unshifted_key = '7'; break;
+                                    case '*': unshifted_key = '8'; break; case '(': unshifted_key = '9'; break;
+                                    case ')': unshifted_key = '0'; break; case '_': unshifted_key = '-'; break;
+                                    case '+': unshifted_key = '='; break; case '{': unshifted_key = '['; break;
+                                    case '}': unshifted_key = ']'; break; case '|': unshifted_key = '\\'; break;
+                                    case ':': unshifted_key = ';'; break; case '"': unshifted_key = '\''; break;
+                                    case '<': unshifted_key = ','; break; case '>': unshifted_key = '.'; break;
+                                    case '?': unshifted_key = '/'; break;
+                                }
+                                
+                                bool shift_active = (modifiers & 1) != 0;
+                                bool caps_active = (modifiers & 64) != 0;
+                                if (gdk_keyval_to_lower(event.keyval()) != gdk_keyval_to_upper(event.keyval()))
+                                        text_codepoint = (shift_active ^ caps_active) ?
+                                                         shifted_key : unshifted_key;
+                                else
+                                        text_codepoint = shift_active ? shifted_key : unshifted_key;
+                        } else {
+                                unshifted_key = kitty_key;
+                                shifted_key = 0;
+                                text_codepoint = produces_text ? gdk_unicode : 0;
+                        }
+
+                        unsigned int mods_bitmap = modifiers;
+                        bool has_other_mods = (mods_bitmap & (2 | 4 | 8 | 16 | 32));
+                        int event_type;
+
+                        if (event.is_key_press()) {
+                                if (m_active_keys.count(event.keyval()))
+                                        event_type = 2;
+                                else {
+                                        m_active_keys.insert(event.keyval());
+                                        event_type = 1;
+                                }
+                        } else {
+                                m_active_keys.erase(event.keyval());
+                                event_type = 3;
+                        }
+
+                        bool use_kitty;
+                        if (report_all)
+                                use_kitty = true;
+                        else if (report_event_types && event_type == 3)
+                                use_kitty = true;
+                        else if (produces_text && !has_other_mods)
+                                use_kitty = false;
+                        else
+                                use_kitty = disambiguate;
+
+                        if (is_plain_special && (mods_bitmap & ~(64 | 128)) == 0)
+                                use_kitty = false;
+
+                        if (!report_event_types) {
+                                if (event_type == 3) return true;
